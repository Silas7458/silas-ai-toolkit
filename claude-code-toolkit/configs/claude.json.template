{
  "_TEMPLATE_INFO": {
    "description": "Claude Code global config template (.claude.json). Copy to C:\Users\{your-username}\.claude.json and fill in all YOUR_* placeholders with real values.",
    "source": "Sanitized from a real Tandem Team / Brother (Claude Code CLI) setup.",
    "howToUse": [
      "1. Copy this file to %USERPROFILE%\.claude.json (Windows) or ~/.claude.json (Linux/Mac)",
      "2. Replace all YOUR_* placeholders with your real credentials and paths",
      "3. Replace {{HOME_DIR}} with your actual home directory path (e.g. C:\Users\yourname)",
      "4. Remove this _TEMPLATE_INFO block before use — Claude Code does not expect it",
      "5. Adjust mcpServers to match the tools you actually have installed"
    ],
    "mcpServersIncluded": [
      "MCP_DOCKER — Docker-based MCP gateway (requires Docker Desktop)",
      "n8n-mcp — n8n workflow automation MCP server",
      "windows-mcp — Windows UI automation (Windows only, requires uvx/Python)",
      "google-drive-mcp — Google Drive/Docs/Sheets access (requires OAuth credentials)",
      "discord-mcp — Discord bot integration (requires a Discord bot token + JAR)",
      "context7 — Context7 library docs (HTTP, no auth required)",
      "playwright — DEPRECATED: Use Playwright CLI instead (4x more token-efficient). MCP config kept for reference only.",
      "github — GitHub MCP server (requires a GitHub personal access token)",
      "firecrawl — Web scraping/crawling (requires a Firecrawl API key)"
    ]
  },

  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ],
      "env": {
        "LOCALAPPDATA": "{{HOME_DIR}}\AppData\Local",
        "ProgramData": "C:\ProgramData",
        "ProgramFiles": "C:\Program Files"
      }
    },

    "n8n-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    },

    "windows-mcp": {
      "type": "stdio",
      "command": "{{HOME_DIR}}\.local\bin\uvx.exe",
      "args": [
        "--from",
        "windows-mcp<2",
        "--with",
        "fastmcp<3",
        "windows-mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },

    "google-drive-mcp": {
      "type": "stdio",
      "command": "{{HOME_DIR}}\.config\google-drive-mcp\start-server.cmd",
      "args": [],
      "env": {
        "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "{{HOME_DIR}}\your-project\credentials\client_secret.json"
      }
    },

    "discord-mcp": {
      "type": "stdio",
      "command": "C:\Program Files\Amazon Corretto\jdk17.0.18_9\bin\java.exe",
      "_note_command": "Adjust path to your Java 17+ installation. discord-mcp.jar is available at https://github.com/your-discord-mcp-source",
      "args": [
        "-jar",
        "{{HOME_DIR}}\tools\discord-mcp\discord-mcp.jar"
      ],
      "env": {
        "DISCORD_TOKEN": "YOUR_DISCORD_BOT_TOKEN_HERE",
        "DISCORD_GUILD_ID": "YOUR_DISCORD_SERVER_ID_HERE"
      }
    },

    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  },

  "projects": {
    "{{HOME_DIR}}\your-project": {
      "_note": "Project-specific MCP servers override global mcpServers for sessions started in this directory. Duplicate this block for each project that needs custom servers.",
      "allowedTools": [],
      "mcpContextUris": [],
      "mcpServers": {
        "playwright": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "@playwright/mcp@latest"
          ],
          "env": {}
        },
        "github": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@anthropic-ai/github-mcp-server"
          ],
          "env": {
            "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT_HERE"
          }
        },
        "firecrawl": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "firecrawl-mcp"
          ],
          "env": {
            "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_API_KEY_HERE"
          }
        }
      },
      "enabledMcpjsonServers": [],
      "disabledMcpjsonServers": [],
      "hasTrustDialogAccepted": true
    }
  }
}
